{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<SERVER>;Database=<DB>;User Id=<USER>;Password=<PASSWORD>;TrustServerCertificate=True;"
  },
  "WhatsAppWebhookFunction": {
    "BaseUrl": "http://localhost:7071",
    "FunctionKey": "<FUNCTION_KEY>",
    "PhoneNumberId": "<PHONE_NUMBER_ID>"
  },
  "BlobStorage": {
    "ConnectionString": "<AZURE_BLOB_CONNECTION_STRING>",
    "ContainerName": "planes-images"
  },
  "OpenAI": {
    "ApiKey": "<YOUR_AZURE_OPENAI_API_KEY>",
    "Endpoint": "<YOUR_AZURE_OPENAI_ENDPOINT>",
    "TextDeploymentName": "gpt-4o-mini",
    "AudioDeploymentName": "whisper-1"
  },
  "WhatsApp": {
    "PhoneNumberId": "<WHATSAPP_PHONE_NUMBER_ID>",
    "AccessToken": "<WHATSAPP_ACCESS_TOKEN>"
  },
  "Wompi": {
    "PrivateKey": "<WOMPI_PRIVATE_KEY>",
    "PublicKey": "<WOMPI_PUBLIC_KEY>",
    "EventsSecret": "<WOMPI_EVENTS_SECRET>",
    "IntegritySecret": "<WOMPI_INTEGRITY_SECRET>",
    "UseSandbox": true,
    "SandboxBaseUrl": "https://sandbox.wompi.co/v1",
    "ProductionBaseUrl": "https://production.wompi.co/v1",
    "RequestTimeoutSeconds": 30,
    "CheckoutBaseUrl": "https://checkout.wompi.co/l/"
  },
  "Calendar": {
    "Provider": "Google",
    "ClientId": "<GOOGLE_CLIENT_ID>",
    "ClientSecret": "<GOOGLE_CLIENT_SECRET>",
    "RefreshToken": "<GOOGLE_REFRESH_TOKEN>",
    "CalendarId": "<YOUR_CALENDAR_EMAIL>",
    "TimeZone": "America/Bogota",
    "Scopes": "https://www.googleapis.com/auth/calendar"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "MimosBabySpa": "Warning"
    }
  }
}
