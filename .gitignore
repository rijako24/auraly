## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.log
artifacts/
.artifacts/
publish/
.deploy/
database/backups/
.tmp/

# Visual Studio cache/options directory
.vs/

# Azure Functions
local.settings.json
.azurefunctions/

# Entity Framework
*.db
*.db-shm
*.db-wal

# NuGet Packages
*.nupkg
**/packages/*

# Rider
.idea/

# VS Code
.vscode/

# Mac
.DS_Store

# App settings (contiene credenciales - NUNCA commitear)
**/appsettings.json
**/appSettings.json
**/appsettings.Development.json
**/appsettings.Production.json
# Plantillas con placeholders sí se commitean: appsettings.Example.json, appSettings.Example.json
